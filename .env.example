# Required. Never expose this key in the browser — only the server route reads it.
ANTHROPIC_API_KEY=

# Optional, development only. With FAKE_MODEL=1 a narrator made of canned prose
# answers instead of the model: no key needed, no bill, five real beats. Opt-in
# on purpose — a deployment whose key expired must fail, not quietly start
# reading canned prose to a child. `npm run dev:fake` sets it for you.
FAKE_MODEL=

# Optional in the MVP. Without these variables the app runs entirely in memory:
# the story works, but nothing is persisted when the page reloads.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional, both of them. Narration works with NEITHER: the default voice is the
# device's own, which costs nothing and needs no account. These two buy quality.
# Server-side only: like the Anthropic key, they never reach the browser.

# Free inside 1M characters/month, recurring — about 285 stories. Needs a GCP
# account with billing attached.
GOOGLE_TTS_API_KEY=

# The paid rung, ~$0.05 per 1k characters. The free plan is personal and
# non-commercial, needs attribution, and its 10k credits/month is about two
# stories — enough to audition a voice, not to read bedtime stories on.
ELEVENLABS_API_KEY=
